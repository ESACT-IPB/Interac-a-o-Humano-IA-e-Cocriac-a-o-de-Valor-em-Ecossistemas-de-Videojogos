        "post_url": "/t/slipway-a-free-industry-planner-what-to-build-where-to-build-it-where-to-sell-it/516921/6",
        "reactions": [],
        "current_user_reaction": null,
        "reaction_users_count": 0,
        "current_user_used_main_reaction": false,
