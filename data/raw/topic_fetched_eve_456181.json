      {
        "id": 2563437,
        "name": "Azna Fos",
        "username": "Azna_Fos",
        "avatar_template": "/user_avatar/forums.eveonline.com/azna_fos/{size}/427252_2.png",
        "created_at": "2024-07-17T11:28:43.504Z",
        "cooked": "<p>Just to bring clarity:</p>\n<ol>\n<li>is botting illegal only on paper while people can actually get away with pretty much anything, or</li>\n<li>there are <strong>legal</strong> means of controling several characters simulteneously to perform meaningful actions (such as automated mining, combat etc.) ?</li>\n</ol>",
        "post_number": 3,
        "post_type": 1,
        "posts_count": 5,
        "updated_at": "2024-07-17T11:28:59.133Z",
