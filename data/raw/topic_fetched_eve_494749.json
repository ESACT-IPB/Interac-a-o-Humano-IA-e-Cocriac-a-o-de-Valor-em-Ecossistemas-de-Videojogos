    "posts": [
      {
        "id": 2757937,
        "name": "Lokar Griman",
        "username": "Lokar_Griman",
        "avatar_template": "/user_avatar/forums.eveonline.com/lokar_griman/{size}/502944_2.png",
        "created_at": "2025-08-01T17:01:12.512Z",
        "cooked": "<p>Deployable small structure that disrupts local chat function within a 10-jump radius and adds a 5-jump local chat delay.<br>\nIt can be deployed in any Nullsec (NS) and Lowsec (LS) area. The structure remains active for a certain time limit or until players in the area combat scan it, hack 5-10 nodes on it, and destroy it. This is a measure against people using cheat tools and bots to farm ISK. The structure must be discoverable by players that are active through a notification , but not by cheat tools.<br>\nPrice should be somewhere where ppl just cant spam them non stop.<br>\nProbably a big ask for somethin like that.</p>\n<p>EDIT: Whatever lock the topic, let bots kill the game ,enjoy your inflation and high plex prices.</p>",
        "post_number": 1,
        "post_type": 1,
        "posts_count": 4,
        "updated_at": "2025-08-01T19:00:43.553Z",
