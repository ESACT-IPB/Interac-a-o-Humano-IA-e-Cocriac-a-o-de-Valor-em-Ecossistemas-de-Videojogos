      {
        "id": 2717175,
        "name": "QuakeGod",
        "username": "QuakeGod",
        "avatar_template": "/user_avatar/forums.eveonline.com/quakegod/{size}/480339_2.png",
        "created_at": "2025-05-14T23:26:31.382Z",
        "cooked": "<p>EVE is a 22 year old game.  There are thousands of YouTube videos, online guides, and Wiki articles to find every item in the game that has ever existed.  Takes all of 2 seconds…</p>",
        "post_number": 3,
